// DilKhush Dhaba – Raita Wala
// Local dev uses SQLite (zero setup). For production:
//   - PostgreSQL: change provider to "postgresql", set DATABASE_URL, migrate dev
//   - MySQL / MariaDB (e.g. cPanel hosting): use prisma/schema.mysql.prisma
//     instead — see docs/DEPLOY_CPANEL.md. It mirrors this file but adds
//     explicit column sizes MySQL requires for the long text fields.
// The schema deliberately avoids SQLite-incompatible features (enums,
// native Json, arrays) so it is portable between providers.
// Pseudo-enum string values are defined in src/lib/constants.ts.
// Fields suffixed `Json` hold JSON-serialised strings.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

// ---------------------------------------------------------------- users

model User {
  id           String   @id @default(cuid())
  phone        String?  @unique // +91XXXXXXXXXX (customers; staff optional)
  email        String?  @unique // staff login
  name         String?
  role         String   @default("CUSTOMER") // CUSTOMER OWNER BRANCH_MANAGER KITCHEN CASHIER DELIVERY_MANAGER DELIVERY_AGENT MARKETING
  passwordHash String? // staff only; customers use OTP
  pinHash      String? // owner quick-unlock PIN, only usable from a trusted device
  blocked      Boolean  @default(false)
  codOnlyBlock Boolean  @default(false) // COD-abuse flag: prepaid only
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  profile            CustomerProfile?
  metrics            CustomerMetrics?
  addresses          Address[]
  orders             Order[]
  favourites         Favourite[]
  loyaltyTx          LoyaltyTransaction[]
  redemptions        CouponRedemption[]
  reviews            Review[]
  tickets            SupportTicket[]
  notifications      Notification[]
  branchAssignments  StaffBranchAssignment[]
  staffDevices       StaffDevice[]
  deliveryAgent      DeliveryAgent?
  carts              Cart[]
}

model CustomerProfile {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  birthday          DateTime?
  anniversary       DateTime?
  notifyPromos      Boolean   @default(true)
  storeCredit       Float     @default(0)
  loyaltyPoints     Int       @default(0)
  loyaltyTierId     String?
  loyaltyTier       LoyaltyTier? @relation(fields: [loyaltyTierId], references: [id])
  referralCode      String?   @unique
  referredByUserId  String?
  preferredBranchId String?
}

model Address {
  id           String  @id @default(cuid())
  userId       String
  user         User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  label        String  @default("Home") // Home / Work / Other
  line1        String
  line2        String?
  landmark     String?
  pincode      String
  lat          Float?
  lng          Float?
  instructions String?
  // Who to hand this delivery to, when that is not the account holder —
  // ordering for a parent, a colleague, a hostel room. Null = use the account.
  contactName  String?
  contactPhone String? // +91XXXXXXXXXX
  isDefault    Boolean @default(false)
  createdAt    DateTime @default(now())
  orders       Order[]
}

// -------------------------------------------------------------- branches

model Branch {
  id                    String  @id @default(cuid())
  slug                  String  @unique
  name                  String
  address               String
  pincode               String
  lat                   Float
  lng                   Float
  phone                 String
  email                 String?
  isOpenOverride        String  @default("AUTO") // AUTO | FORCE_OPEN | FORCE_CLOSED
  onlineOrderingEnabled Boolean @default(true)
  deliveryEnabled       Boolean @default(true)
  pickupEnabled         Boolean @default(true)
  deliveryRadiusKm      Float   @default(6)
  serviceablePincodesJson String @default("[]") // JSON array of PIN strings
  minOrderValue         Float   @default(0)
  baseDeliveryFee       Float   @default(30)
  perKmFee              Float   @default(6) // beyond freeKm
  freeKm                Float   @default(3)
  freeDeliveryAbove     Float?  // cart subtotal for free delivery
  packagingFee          Float   @default(15)
  taxPercent            Float   @default(5)
  prepTimeMins          Int     @default(25)
  busyMode              Boolean @default(false)
  busyExtraMins         Int     @default(15)
  busyPauseDelivery     Boolean @default(false)
  busyPauseScheduled    Boolean @default(false)
  maxActiveOrders       Int     @default(30)
  createdAt             DateTime @default(now())
  updatedAt             DateTime @updatedAt

  hours          BranchHours[]
  zones          DeliveryZone[]
  branchItems    BranchMenuItem[]
  orders         Order[]
  staff          StaffBranchAssignment[]
  carts          Cart[]
}

model BranchHours {
  id        String  @id @default(cuid())
  branchId  String
  branch    Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  dayOfWeek Int // 0=Sunday … 6=Saturday
  openTime  String // "HH:mm" 24h
  closeTime String
  closed    Boolean @default(false)

  @@unique([branchId, dayOfWeek])
}

model DeliveryZone {
  id           String  @id @default(cuid())
  branchId     String
  branch       Branch  @relation(fields: [branchId], references: [id], onDelete: Cascade)
  name         String
  pincodesJson String  @default("[]")
  feeOverride  Float?
  minOrder     Float?
  active       Boolean @default(true)
}

// ------------------------------------------------------------------ menu

model Category {
  id           String     @id @default(cuid())
  name         String
  slug         String     @unique
  displayOrder Int        @default(0)
  active       Boolean    @default(true)
  items        MenuItem[]
}

model MenuItem {
  id           String  @id @default(cuid())
  categoryId   String
  category     Category @relation(fields: [categoryId], references: [id])
  name         String
  nameHindi    String?
  description  String  @default("")
  imageUrl     String? // object-storage URL; PLACEHOLDER emoji fallback used when null
  imageEmoji   String  @default("🍛")
  basePrice    Float
  veg          Boolean @default(true)
  vegan        Boolean @default(false)
  spicy        Boolean @default(false)
  bestseller   Boolean @default(false)
  recommended  Boolean @default(false)
  prepTimeMins Int     @default(20)
  ingredients  String  @default("")
  allergens    String  @default("")
  taxCategory  String  @default("STANDARD")
  active       Boolean @default(true)
  displayOrder Int     @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  variants    MenuItemVariant[]
  addOns      AddOn[]
  branchItems BranchMenuItem[]
  orderItems  OrderItem[]
  favourites  Favourite[]
  cartItems   CartItem[]
}

model MenuItemVariant {
  id         String   @id @default(cuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name       String // "Half", "Full", "Large"
  priceDelta Float    @default(0) // added to basePrice (can be negative)
  isDefault  Boolean  @default(false)
  active     Boolean  @default(true)
}

model AddOn {
  id         String   @id @default(cuid())
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  name       String // "Extra Raita", "Extra Butter"…
  price      Float    @default(0)
  veg        Boolean  @default(true)
  required   Boolean  @default(false)
  active     Boolean  @default(true)
}

// Per-branch price/availability/stock override.
model BranchMenuItem {
  id            String   @id @default(cuid())
  branchId      String
  branch        Branch   @relation(fields: [branchId], references: [id], onDelete: Cascade)
  menuItemId    String
  menuItem      MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  priceOverride Float?
  available     Boolean  @default(true)
  stockQty      Int      @default(-1) // -1 = untracked/unlimited
  availableFrom String? // "HH:mm" daily window start
  availableTo   String?

  @@unique([branchId, menuItemId])
}

model Favourite {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  menuItemId String
  menuItem   MenuItem @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@unique([userId, menuItemId])
}

// ------------------------------------------------------------------ cart

model Cart {
  id        String     @id @default(cuid())
  userId    String?
  user      User?      @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId  String
  branch    Branch     @relation(fields: [branchId], references: [id], onDelete: Cascade)
  updatedAt DateTime   @updatedAt
  items     CartItem[]
}

model CartItem {
  id           String   @id @default(cuid())
  cartId       String
  cart         Cart     @relation(fields: [cartId], references: [id], onDelete: Cascade)
  menuItemId   String
  menuItem     MenuItem @relation(fields: [menuItemId], references: [id])
  variantName  String?
  addOnsJson   String   @default("[]")
  qty          Int      @default(1)
  instructions String?
}

// ---------------------------------------------------------------- orders

model Order {
  id              String    @id @default(cuid())
  orderNumber     String    @unique
  userId          String
  user            User      @relation(fields: [userId], references: [id])
  branchId        String
  branch          Branch    @relation(fields: [branchId], references: [id])
  type            String // DELIVERY | PICKUP | DINE_IN
  tableNo         String? // dine-in only, e.g. "4" or "Terrace 2"
  status          String    @default("PLACED") // see ORDER_STATUSES in constants.ts
  scheduledFor    DateTime?
  addressId       String?
  address         Address?  @relation(fields: [addressId], references: [id])
  addressText     String? // immutable snapshot at order time
  addressPincode  String?
  addressLat      Float?
  addressLng      Float?
  // Snapshot of the delivery contact at order time, so editing or deleting the
  // saved address later cannot change who the agent was told to call.
  contactName     String?
  contactPhone    String?
  contactless     Boolean   @default(false)
  instructions    String?
  cutlery         Boolean   @default(true)
  distanceKm      Float?

  subtotal        Float
  discount        Float     @default(0)
  deliveryFee     Float     @default(0)
  packagingFee    Float     @default(0)
  tax             Float     @default(0)
  loyaltyCredit   Float     @default(0) // rupee value of points redeemed
  total           Float

  paymentMethod   String    @default("COD") // COD | ONLINE
  paymentStatus   String    @default("PENDING") // PENDING | PAID | FAILED | REFUNDED
  couponCode      String?
  couponId        String?
  pointsRedeemed  Int       @default(0)
  pointsEarned    Int       @default(0)
  prepTimeMins    Int       @default(25)
  etaMins         Int?
  rejectionReason String?
  cancelReason    String?
  staffNotes      String?
  deliveryAgentId String?
  deliveryAgent   DeliveryAgent? @relation(fields: [deliveryAgentId], references: [id])

  placedAt    DateTime  @default(now())
  acceptedAt  DateTime?
  readyAt     DateTime?
  outAt       DateTime?
  deliveredAt DateTime?
  cancelledAt DateTime?

  items       OrderItem[]
  payment     Payment?
  refunds     Refund[]
  redemptions CouponRedemption[]
  review      Review?
  tickets     SupportTicket[]
  loyaltyTx   LoyaltyTransaction[]

  @@index([branchId, status])
  @@index([userId, placedAt])
}

model OrderItem {
  id           String    @id @default(cuid())
  orderId      String
  order        Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItemId   String?
  menuItem     MenuItem? @relation(fields: [menuItemId], references: [id])
  nameSnapshot String
  variantName  String?
  addOnsJson   String    @default("[]") // [{name, price}]
  unitPrice    Float // variant + add-ons included
  qty          Int
  lineTotal    Float
  instructions String?
  // Dine-in tabs are added to over several rounds. The kitchen must be able to
  // tell a newly ordered item from one it already cooked and served.
  round        Int       @default(1)
  addedAt      DateTime  @default(now())
}

model Payment {
  id              String   @id @default(cuid())
  orderId         String   @unique
  order           Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  provider        String   @default("cod") // cod | razorpay | …
  method          String   @default("COD")
  status          String   @default("PENDING")
  amount          Float
  providerOrderId String?
  providerRef     String?
  webhookVerified Boolean  @default(false)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

model Refund {
  id        String   @id @default(cuid())
  orderId   String
  order     Order    @relation(fields: [orderId], references: [id])
  amount    Float
  mode      String // CASH | STORE_CREDIT | LOYALTY_POINTS | COUPON | REPLACEMENT
  reason    String
  status    String   @default("INITIATED") // INITIATED | COMPLETED
  createdBy String
  createdAt DateTime @default(now())
}

// --------------------------------------------------------- coupons/loyalty

model Coupon {
  id               String    @id @default(cuid())
  code             String    @unique // uppercase
  name             String
  description      String    @default("")
  rewardType       String // PERCENT | FLAT | FREE_DELIVERY | FREE_ITEM
  value            Float     @default(0) // percent or flat ₹
  maxDiscount      Float?
  freeItemId       String?
  minCartValue     Float?
  maxCartValue     Float?
  branchId         String? // null = all branches
  orderTypesJson   String    @default("[\"DELIVERY\",\"PICKUP\"]")
  daysOfWeekJson   String    @default("[]") // [] = all days
  startTime        String? // "HH:mm" daily window
  endTime          String?
  startAt          DateTime?
  endAt            DateTime?
  firstOrderOnly   Boolean   @default(false)
  minCompletedOrders Int?
  minLifetimeSpend Float?
  loyaltyTierId    String?
  inactiveDays     Int? // eligible if no order in N days
  paymentMethod    String? // restrict to COD / ONLINE
  totalLimit       Int?
  perCustomerLimit Int       @default(1)
  autoApply        Boolean   @default(false)
  stackable        Boolean   @default(false)
  priority         Int       @default(0)
  active           Boolean   @default(true)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  redemptions CouponRedemption[]
}

model CouponRedemption {
  id          String   @id @default(cuid())
  couponId    String
  coupon      Coupon   @relation(fields: [couponId], references: [id])
  orderId     String
  order       Order    @relation(fields: [orderId], references: [id])
  userId      String
  user        User     @relation(fields: [userId], references: [id])
  amountSaved Float
  createdAt   DateTime @default(now())

  @@index([couponId, userId])
}

model LoyaltyTier {
  id                 String  @id @default(cuid())
  name               String
  minCompletedOrders Int     @default(0)
  minLifetimeSpend   Float   @default(0)
  pointMultiplier    Float   @default(1)
  freeDelivery       Boolean @default(false)
  discountPercent    Float   @default(0)
  benefitsText       String  @default("")
  sortOrder          Int     @default(0)

  profiles CustomerProfile[]
}

/// What a DilKhush point is worth. A single row ("singleton") so the owner can
/// reprice the loyalty scheme from the dashboard instead of needing a deploy.
model LoyaltySettings {
  id                String   @id @default("singleton")
  pointsPer10Rupees Float    @default(1)
  pointValueRupees  Float    @default(0.5)
  minPointsToRedeem Int      @default(100)
  updatedAt         DateTime @updatedAt
}

model LoyaltyTransaction {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  orderId   String?
  order     Order?   @relation(fields: [orderId], references: [id])
  points    Int // positive = earn, negative = redeem
  type      String // EARN | REDEEM | ADJUST | BONUS
  note      String   @default("")
  createdAt DateTime @default(now())
}

model CustomerMetrics {
  id                String    @id @default(cuid())
  userId            String    @unique
  user              User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  completedOrders   Int       @default(0)
  cancelledOrders   Int       @default(0)
  rejectedOrders    Int       @default(0)
  lifetimeSpend     Float     @default(0)
  avgOrderValue     Float     @default(0)
  lastOrderAt       DateTime?
  firstOrderAt      DateTime?
  preferredBranchId String?
}

// ------------------------------------------------------- support & misc

model Review {
  id              String   @id @default(cuid())
  orderId         String   @unique
  order           Order    @relation(fields: [orderId], references: [id])
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  foodRating      Int
  packagingRating Int?
  deliveryRating  Int?
  overallRating   Int
  comment         String?
  ownerReply      String?
  createdAt       DateTime @default(now())
}

model SupportTicket {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id])
  orderId    String?
  order      Order?   @relation(fields: [orderId], references: [id])
  type       String // MISSING_ITEM | WRONG_ITEM | LATE | QUALITY | PAYMENT | COUPON | PACKAGING | OTHER
  message    String
  status     String   @default("OPEN") // OPEN | IN_PROGRESS | RESOLVED | CLOSED
  resolution String?
  assignedTo String?
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}

model StaffBranchAssignment {
  id       String @id @default(cuid())
  userId   String
  user     User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  branchId String
  branch   Branch @relation(fields: [branchId], references: [id], onDelete: Cascade)

  @@unique([userId, branchId])
}

model DeliveryAgent {
  id        String  @id @default(cuid())
  userId    String  @unique
  user      User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  online    Boolean @default(false)
  vehicle   String?
  codHeld   Float   @default(0) // cash collected pending reconciliation
  orders    Order[]
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  channel   String   @default("IN_APP") // IN_APP | SMS | WHATSAPP | EMAIL | PUSH
  type      String // ORDER_PLACED | ORDER_ACCEPTED | … | PROMO
  title     String
  body      String
  status    String   @default("QUEUED") // QUEUED | SENT | FAILED
  createdAt DateTime @default(now())
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  actorName String?
  action    String // e.g. ORDER_ACCEPTED, PRICE_CHANGED, COUPON_CREATED
  entity    String
  entityId  String?
  detail    String? // JSON snapshot of the action payload; unbounded length
  createdAt DateTime @default(now())

  @@index([entity, entityId])
}

/// A browser the owner has already signed into with email + password. Holding
/// one of these is what makes a 4-6 digit PIN safe: the PIN alone is useless
/// without the device cookie that points at this row.
model StaffDevice {
  id         String   @id @default(cuid())
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  tokenHash  String   @unique
  label      String   @default("")
  lastUsedAt DateTime @default(now())
  createdAt  DateTime @default(now())

  @@index([userId])
}

model OtpCode {
  id         String    @id @default(cuid())
  phone      String
  codeHash   String
  expiresAt  DateTime
  attempts   Int       @default(0)
  consumedAt DateTime?
  createdAt  DateTime  @default(now())

  @@index([phone, createdAt])
}
