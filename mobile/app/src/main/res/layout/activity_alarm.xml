<?xml version="1.0" encoding="utf-8"?>
<!--
  Sized to be read from the far side of a kitchen. The order number is the
  biggest thing on the phone because it is the only thing anyone needs before
  deciding to walk over.
-->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="@color/maroon_900">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🔔"
        android:textSize="64sp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:text="@string/alarm_heading"
        android:textColor="@color/mustard_300"
        android:textSize="15sp"
        android:textStyle="bold"
        android:letterSpacing="0.3" />

    <TextView
        android:id="@+id/orderNumber"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:textColor="@color/cream_50"
        android:textSize="52sp"
        android:textStyle="bold"
 />

    <TextView
        android:id="@+id/total"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="@color/mustard_200"
        android:textSize="36sp"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/detail"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:gravity="center"
        android:textColor="@color/cream_50"
        android:textSize="18sp" />

    <TextView
        android:id="@+id/branch"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:textColor="#99FFFDF7"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/more"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="16dp"
        android:paddingHorizontal="18dp"
        android:paddingVertical="8dp"
        android:background="#26FFFDF7"
        android:textColor="@color/cream_50"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone" />

    <Button
        android:id="@+id/open"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="32dp"
        android:minHeight="64dp"
        android:text="@string/alarm_open"
        android:textSize="19sp"
        android:textStyle="bold"
        android:textColor="@color/maroon_900"
        android:backgroundTint="@color/mustard_300" />

    <Button
        android:id="@+id/silence"
        style="?android:attr/borderlessButtonStyle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:minHeight="56dp"
        android:text="@string/alarm_silence"
        android:textSize="17sp"
        android:textColor="@color/cream_50" />
</LinearLayout>
