<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="Theme.Dashboard" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorPrimary">@color/maroon_700</item>
        <item name="colorPrimaryDark">@color/maroon_900</item>
        <item name="colorAccent">@color/mustard_300</item>
        <item name="android:windowBackground">@color/cream_100</item>
        <item name="android:statusBarColor">@color/maroon_700</item>
    </style>

    <!-- Full bleed: the alarm is the whole screen, including behind the clock. -->
    <style name="Theme.Dashboard.Alarm" parent="Theme.Dashboard">
        <item name="android:windowBackground">@color/maroon_900</item>
        <item name="android:statusBarColor">@color/maroon_900</item>
        <item name="android:navigationBarColor">@color/maroon_900</item>
        <item name="android:windowNoTitle">true</item>
    </style>
</resources>
