# ============================================================
# DilKhush Dhaba – environment configuration (EXAMPLE FILE)
# Copy to .env and fill real values. NEVER commit real secrets.
# ============================================================

# --- Database -------------------------------------------------
# Local development (default, zero-setup):
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL) — also change provider to "postgresql"
# in prisma/schema.prisma, then run: npx prisma migrate dev
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/dilkhush?schema=public"
# Production (MySQL / MariaDB — e.g. cPanel "MySQL Databases"):
# Use prisma/schema.mysql.prisma (see docs/DEPLOY_CPANEL.md). cPanel MySQL
# usernames/db names are typically prefixed with your cPanel username, e.g.
# "cpaneluser_dilkhush". Socket-only hosts may need "localhost" as HOST.
# DATABASE_URL="mysql://cpaneluser_dbuser:PASSWORD@localhost:3306/cpaneluser_dilkhush"

# --- Sessions -------------------------------------------------
# 32+ random chars. Generate: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET_32+_CHARS"
# Sign-in cookies are Secure (HTTPS-only) in production by default.
# Set "false" ONLY to test a production build over plain HTTP (e.g. LAN testing).
# COOKIE_SECURE="true"

# --- OTP / SMS provider (modular) -----------------------------
# "console"  = OTP printed to server console & shown on the login screen (DEV ONLY)
# "fast2sms" = Fast2SMS OTP route — quickest real-SMS start in India (no DLT
#              template needed; message is their fixed "Your OTP: XXXXXX").
#              Get an API key at fast2sms.com → Dev API.
# "msg91"    = MSG91 OTP API — production-grade; requires a DLT-approved OTP
#              template containing the ##otp## variable.
OTP_PROVIDER="console"
FAST2SMS_API_KEY=""
MSG91_AUTH_KEY=""
MSG91_TEMPLATE_ID=""
MSG91_SENDER_ID="DLKHSH"
# ⚠️ TEMPORARY LAUNCH SWITCH — skips OTP verification completely: any phone
# number can sign in with no proof of ownership. Both vars must be set
# together (one is server-side, one is inlined into the browser bundle at
# build time). Set BOTH to "false" and rebuild the moment a real SMS
# provider (MSG91 + DLT template, or Fast2SMS) is configured above.
OTP_BYPASS="false"
NEXT_PUBLIC_OTP_BYPASS="false"

# --- Payments (modular, feature-flagged) ----------------------
# "cod" only in v1. Set to "razorpay" once keys are configured.
PAYMENT_PROVIDER="cod"
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
RAZORPAY_WEBHOOK_SECRET=""

# --- Maps / routing (modular) ---------------------------------
# "haversine" = built-in straight-line x road-factor estimate (no key needed)
# "google"    = Google Distance Matrix (restrict the key by referrer/IP!)
MAPS_PROVIDER="haversine"
GOOGLE_MAPS_SERVER_KEY=""
# Public browser key (map display only — restrict by HTTP referrer)
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=""

# --- Notifications (modular channels) -------------------------
NOTIFY_SMS_ENABLED="false"
NOTIFY_WHATSAPP_ENABLED="false"
NOTIFY_EMAIL_ENABLED="false"
SMTP_URL=""
WHATSAPP_API_KEY=""

# --- App ------------------------------------------------------
NEXT_PUBLIC_APP_NAME="DilKhush Dhaba – Raita Wala"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
