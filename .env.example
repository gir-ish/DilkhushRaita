# ============================================================
# DilKhush Dhaba – environment configuration (EXAMPLE FILE)
# Copy to .env and fill real values. NEVER commit real secrets.
# ============================================================

# --- Database -------------------------------------------------
# Local development (default, zero-setup):
DATABASE_URL="file:./dev.db"
# Production (PostgreSQL) — also change provider to "postgresql"
# in prisma/schema.prisma, then run: npx prisma migrate dev
# DATABASE_URL="postgresql://USER:PASSWORD@HOST:5432/dilkhush?schema=public"
# Production (MySQL / MariaDB — e.g. cPanel "MySQL Databases"):
# Use prisma/schema.mysql.prisma (see docs/DEPLOY_CPANEL.md). cPanel MySQL
# usernames/db names are typically prefixed with your cPanel username, e.g.
# "cpaneluser_dilkhush". Socket-only hosts may need "localhost" as HOST.
# DATABASE_URL="mysql://cpaneluser_dbuser:PASSWORD@localhost:3306/cpaneluser_dilkhush"

# --- Sessions -------------------------------------------------
# 32+ random chars. Generate: node -e "console.log(crypto.randomBytes(32).toString('hex'))"
SESSION_SECRET="REPLACE_WITH_A_LONG_RANDOM_SECRET_32+_CHARS"
# Sign-in cookies are Secure (HTTPS-only) in production by default.
# Set "false" ONLY to test a production build over plain HTTP (e.g. LAN testing).
# COOKIE_SECURE="true"
# How many proxies of ours sit in front of the app. X-Forwarded-For is a list
# each proxy appends to, so the entries on the left are whatever the caller
# sent — forged freely — and only the ones our own proxies added mean anything.
# 1 is right for cPanel/Passenger (the single Apache in front). Raise it if the
# site is later put behind Cloudflare or a load balancer as well.
# TRUSTED_PROXY_HOPS="1"

# --- OTP / SMS provider (modular) -----------------------------
# "console"  = OTP printed to server console & shown on the login screen (DEV ONLY)
# "stpl"     = STPL / smsfortius.org — the shop's gateway, and the only one
#              that sends a real message. See STPL_* below.
# "console" is a dev tool, not a gateway: it prints the code to the terminal so
# you can sign in locally without spending an SMS. It refuses to run in
# production, where printing codes to a log instead of sending them would mean
# nobody can sign in and every code sits in a file.
OTP_PROVIDER="console"

# --- STPL / smsfortius.org -------------------------------------------------
# Generated in the SMS account. Optional for accounts that authenticate by
# route instead; when set it is sent as the apikey parameter.
STPL_API_KEY=""
# The sender ID registered to the account. Exactly 6 characters.
STPL_SENDER_ID=""
# The DLT template ID registered for the message below. Optional — without it
# the gateway guesses which template the text matches — but set it in
# production so the match is exact.
# DilKhush's approved template ("SMS One", approved 26-08-2026):
#   STPL_TEMPLATE_ID="1777178772255400845"
STPL_TEMPLATE_ID=""
# The message itself. {otp} is replaced with the code.
# DLT writes its variable slots as {#var#}. Put {otp} where the code goes and a
# literal value in every other slot — "Dear {#var#}" becomes "Dear Customer".
# A message still holding an unfilled {#var#} is refused rather than sent.
# ⚠️ This must match your DLT-approved template WORD FOR WORD. Indian operators
# compare every message against the registered template and silently drop
# anything that differs — the API still answers "submitted successfully", so a
# mismatch looks like a working integration where no SMS ever arrives.
STPL_MESSAGE="{otp} is your OTP for DilKhush Dhaba. Valid for 5 minutes. Do not share it with anyone."
# ⚠️ TEMPORARY LAUNCH SWITCH — skips OTP verification completely: any phone
# number can sign in with no proof of ownership. Both vars must be set
# together (one is server-side, one is inlined into the browser bundle at
# build time). Set BOTH to "false" and rebuild the moment OTP_PROVIDER="stpl"
# is configured above and a test message has reached a real handset.
OTP_BYPASS="false"
NEXT_PUBLIC_OTP_BYPASS="false"
# Whole-system ceiling on OTP sends per hour (default 200). Every send costs
# money, and per-number limits do not stop one script walking a list of
# numbers. Raise only if the shop genuinely sends more than this.
# OTP_MAX_PER_HOUR_GLOBAL="200"

# --- Payments (modular, feature-flagged) ----------------------
# "cod" only in v1. Set BOTH to "razorpay" once keys are configured —
# NEXT_PUBLIC_* is baked in at build time, so rebuild after changing it.
# The server value is what actually enforces this; the public one only
# decides whether the "Pay online" option is shown at checkout.
PAYMENT_PROVIDER="cod"
NEXT_PUBLIC_PAYMENT_PROVIDER="cod"
# Test keys (rzp_test_…) work without KYC. Never commit real values.
RAZORPAY_KEY_ID=""
RAZORPAY_KEY_SECRET=""
# Razorpay Dashboard → Settings → Webhooks. Any strong random string;
# it must match exactly what you enter there.
RAZORPAY_WEBHOOK_SECRET=""

# --- Maps / routing (modular) ---------------------------------
# "haversine" = built-in straight-line x road-factor estimate (no key needed)
# "google"    = Google Distance Matrix (restrict the key by referrer/IP!)
MAPS_PROVIDER="haversine"
GOOGLE_MAPS_SERVER_KEY=""
# Public browser key (map display only — restrict by HTTP referrer)
NEXT_PUBLIC_GOOGLE_MAPS_BROWSER_KEY=""

# --- Notifications (modular channels) -------------------------
NOTIFY_SMS_ENABLED="false"
NOTIFY_WHATSAPP_ENABLED="false"
NOTIFY_EMAIL_ENABLED="false"
WHATSAPP_API_KEY=""

# --- App ------------------------------------------------------
NEXT_PUBLIC_APP_NAME="DilKhush Dhaba – Raita Wala"
NEXT_PUBLIC_BASE_URL="http://localhost:3000"
